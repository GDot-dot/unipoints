rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Universal Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprints
    function isValidPoint(data, userId) {
      return (!('userId' in data) || data.userId == userId);
    }

    function isValidGroup(data, userId) {
      return (!('userId' in data) || data.userId == userId);
    }

    function isValidProfile(data, userId) {
      return (!('userId' in data) || data.userId == userId);
    }

    function isValidActivity(data, userId) {
      return (!('userId' in data) || data.userId == userId);
    }

    function isValidNotification(data, userId) {
      return (!('userId' in data) || data.userId == userId);
    }

    // Match users
    match /users/{userId} {
      allow read, write: if isOwner(userId);
      
      match /{allPaths=**} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
