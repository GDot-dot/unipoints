rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Default Deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Universal Helpers
    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }
    
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation Blueprints
    function isValidPoint(data, userId) {
      let typesOk = (!('provider' in data) || (data.provider is string && data.provider.size() <= 100)) &&
                    (!('type' in data) || (data.type is string && data.type.size() <= 100)) &&
                    (!('balance' in data) || (data.balance is number && data.balance >= 0)) &&
                    (!('expiring' in data) || (data.expiring is number && data.expiring >= 0)) &&
                    (!('color' in data) || (data.color is string && data.color.size() <= 50)) &&
                    (!('iconName' in data) || (data.iconName is string && data.iconName.size() <= 50)) &&
                    (!('userId' in data) || (data.userId == userId)) &&
                    (!('createdAt' in data) || (data.createdAt is timestamp)) &&
                    (!('updatedAt' in data) || (data.updatedAt is timestamp));
                    
      let expireDateOk = !('expireDate' in data) || data.expireDate == null || (data.expireDate is string && data.expireDate.size() <= 20);
      let groupIdOk = !('groupId' in data) || data.groupId == null || (data.groupId is string && data.groupId.size() <= 128);
      let idOk = !('id' in data) || (data.id is string && data.id.size() <= 128);

      // Check if there are no shadow fields (allowed keys)
      let allowedKeys = ['provider', 'type', 'balance', 'expiring', 'expireDate', 'color', 'iconName', 'groupId', 'userId', 'createdAt', 'updatedAt', 'id'];
      let noExtraKeys = data.keys().hasOnly(allowedKeys);

      return typesOk && expireDateOk && groupIdOk && idOk && noExtraKeys;
    }

    function isValidGroup(data, userId) {
      let typesOk = (!('name' in data) || (data.name is string && data.name.size() <= 100)) &&
                    (!('userId' in data) || (data.userId == userId)) &&
                    (!('createdAt' in data) || (data.createdAt is timestamp)) &&
                    (!('updatedAt' in data) || (data.updatedAt is timestamp));
      
      let idOk = !('id' in data) || (data.id is string && data.id.size() <= 128);
      let allowedKeys = ['name', 'userId', 'createdAt', 'updatedAt', 'id'];
      let noExtraKeys = data.keys().hasOnly(allowedKeys);
                    
      return typesOk && idOk && noExtraKeys;
    }

    function isValidProfile(data, userId) {
      let typesOk = (!('lineConnected' in data) || (data.lineConnected is bool)) &&
                    (!('userId' in data) || (data.userId == userId)) &&
                    (!('createdAt' in data) || (data.createdAt is timestamp)) &&
                    (!('updatedAt' in data) || (data.updatedAt is timestamp));
                    
      let lineProfileOk = !('lineProfile' in data) || data.lineProfile == null || (
        data.lineProfile is map && 
        data.lineProfile.keys().hasAll(['name', 'pictureUrl']) && 
        data.lineProfile.name is string && data.lineProfile.name.size() <= 100 &&
        data.lineProfile.pictureUrl is string && data.lineProfile.pictureUrl.size() <= 500
      );

      let idOk = !('id' in data) || (data.id is string && data.id.size() <= 128);
      let allowedKeys = ['lineConnected', 'lineProfile', 'userId', 'createdAt', 'updatedAt', 'id'];
      let noExtraKeys = data.keys().hasOnly(allowedKeys);

      return typesOk && lineProfileOk && idOk && noExtraKeys;
    }

    // Match users
    match /users/{userId} {
      match /points/{pointId} {
        allow read: if isOwner(userId);
        
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        
        allow create: if isOwner(userId) && 
                         isValidId(pointId) && 
                         incoming().keys().hasAll(['provider', 'type', 'balance', 'expiring', 'color', 'iconName', 'userId', 'createdAt', 'updatedAt']) &&
                         isValidPoint(incoming(), userId) &&
                         incoming().createdAt == request.time &&
                         incoming().updatedAt == request.time;
                         
        allow update: if isOwner(userId) && 
                         isValidId(pointId) &&
                         isValidPoint(incoming(), userId) &&
                         (!('createdAt' in incoming()) || (incoming().createdAt == existing().createdAt)) &&
                         (!('userId' in incoming()) || (incoming().userId == existing().userId)) &&
                         incoming().updatedAt == request.time &&
                         // All updatable fields
                         incoming().diff(existing()).affectedKeys().hasOnly(['provider', 'type', 'balance', 'expiring', 'expireDate', 'color', 'iconName', 'groupId', 'updatedAt', 'id']);
                         
        allow delete: if isOwner(userId);
      }

      match /groups/{groupId} {
        allow read: if isOwner(userId);
        
        allow list: if isOwner(userId) && existing().userId == request.auth.uid;
        
        allow create: if isOwner(userId) && 
                         isValidId(groupId) && 
                         incoming().keys().hasAll(['name', 'userId', 'createdAt', 'updatedAt']) &&
                         isValidGroup(incoming(), userId) &&
                         incoming().createdAt == request.time &&
                         incoming().updatedAt == request.time;
                         
        allow update: if isOwner(userId) && 
                         isValidId(groupId) &&
                         isValidGroup(incoming(), userId) &&
                         (!('createdAt' in incoming()) || (incoming().createdAt == existing().createdAt)) &&
                         (!('userId' in incoming()) || (incoming().userId == existing().userId)) &&
                         incoming().updatedAt == request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt', 'id']);
                         
        allow delete: if isOwner(userId);
      }

      match /profile/info {
        allow read: if isOwner(userId);
        
        allow list: if false; // only get is needed for single profile info
        
        allow create: if isOwner(userId) && 
                         incoming().keys().hasAll(['lineConnected', 'userId', 'createdAt', 'updatedAt']) &&
                         isValidProfile(incoming(), userId) &&
                         incoming().createdAt == request.time &&
                         incoming().updatedAt == request.time;
                         
        allow update: if isOwner(userId) && 
                         isValidProfile(incoming(), userId) &&
                         (!('createdAt' in incoming()) || (incoming().createdAt == existing().createdAt)) &&
                         (!('userId' in incoming()) || (incoming().userId == existing().userId)) &&
                         incoming().updatedAt == request.time &&
                         incoming().diff(existing()).affectedKeys().hasOnly(['lineConnected', 'lineProfile', 'updatedAt', 'id']);
                         
        allow delete: if isOwner(userId);
      }
    }
  }
}
