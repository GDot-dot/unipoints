{
  "entities": {
    "Point": {
      "title": "Point",
      "description": "Represents a user's point balance from a specific provider.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "provider": { "type": "string" },
        "type": { "type": "string" },
        "balance": { "type": "number" },
        "expiring": { "type": "number" },
        "expireDate": { "type": ["string", "null"] },
        "reminderDays": { "type": ["number", "string", "null"] },
        "color": { "type": "string" },
        "iconName": { "type": "string" },
        "groupId": { "type": ["string", "null"] },
        "userId": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["provider", "type", "balance", "expiring", "color", "iconName", "userId", "createdAt", "updatedAt"]
    },
    "PointGroup": {
      "title": "PointGroup",
      "description": "Groups of points.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "userId": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["name", "userId", "createdAt", "updatedAt"]
    },
    "Profile": {
      "title": "Profile",
      "description": "User profile settings including LINE connection.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "lineConnected": { "type": "boolean" },
        "lineProfile": {
          "type": ["object", "null"],
          "properties": {
            "name": { "type": "string" },
            "pictureUrl": { "type": "string" },
            "lineUserId": { "type": "string" }
          }
        },
        "userId": { "type": "string" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" }
      },
      "required": ["lineConnected", "userId", "createdAt", "updatedAt"]
    },
    "Activity": {
      "title": "Activity",
      "description": "User wish activities.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "cost": { "type": "string" },
        "provider": { "type": "string" },
        "tag": { "type": "string" },
        "description": { "type": "string" },
        "userId": { "type": "string" }
      },
      "required": ["title", "cost", "provider", "userId"]
    },
    "Notification": {
      "title": "Notification",
      "description": "System smart notifications.",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "title": { "type": "string" },
        "message": { "type": "string" },
        "time": { "type": "string" },
        "isUnread": { "type": "boolean" },
        "userId": { "type": "string" }
      },
      "required": ["title", "message", "isUnread", "userId"]
    }
  },
  "firestore": {
    "/users/{userId}/points/{pointId}": {
      "schema": { "$ref": "#/entities/Point" },
      "description": "User's points data."
    },
    "/users/{userId}/groups/{groupId}": {
      "schema": { "$ref": "#/entities/PointGroup" },
      "description": "User's points groups."
    },
    "/users/{userId}/profile/info": {
      "schema": { "$ref": "#/entities/Profile" },
      "description": "User's specific profile info and LINE integration."
    },
    "/users/{userId}/activities/{activityId}": {
      "schema": { "$ref": "#/entities/Activity" },
      "description": "User's wish activities list."
    },
    "/users/{userId}/notifications/{notificationId}": {
      "schema": { "$ref": "#/entities/Notification" },
      "description": "User's notification items."
    }
  }
}
